{
  "name": "dyslinks",
  "version": "1.3.1",
  "description": "Modern URL shortener.",
  "main": "./server/server.js",
  "scripts": {
    "dev": "node --watch-path=./server --watch-path=./custom server/server.js",
    "start": "node server/server.js --production",
    "migrate": "knex migrate:latest",
    "migrate:make": "knex migrate:make",
    "test": "node --test \"server/tests/**/*.test.js\"",
    "docs:build": "cd docs/api && node generate && cd ../.."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theALTERRA/dyslinks.git"
  },
  "keywords": [
    "url-shortener"
  ],
  "author": "Pouria Ezzati <ezzati.upt@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/theALTERRA/dyslinks/issues"
  },
  "homepage": "https://github.com/theALTERRA/dyslinks#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.2.0",
    "bullmq": "6.7.10",
    "cookie-parser": "1.4.7",
    "cookie-session": "2.1.1",
    "cors": "2.8.6",
    "date-fns": "4.4.0",
    "dotenv": "18.0.10",
    "envalid": "9.0.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "express-useragent": "2.2.3",
    "express-validator": "7.3.2",
    "geoip-lite": "2.0.3",
    "hbs": "4.4.0",
    "helmet": "8.3.0",
    "ioredis": "6.1.0",
    "isbot": "5.2.4",
    "jsonwebtoken": "9.0.3",
    "knex": "3.3.0",
    "ms": "2.1.3",
    "mysql2": "3.24.6",
    "nanoid": "6.0.2",
    "nodemailer": "10.6.1",
    "openid-client": "6.9.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pg": "8.23.1",
    "pg-query-stream": "4.17.1",
    "rate-limit-redis": "6.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/hbs": "4.0.5",
    "@types/jsonwebtoken": "9.0.10",
    "@types/ms": "2.1.0",
    "@types/node": "26.6.7",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "redoc": "3.2.0"
  }
}
