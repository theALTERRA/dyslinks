<table id="domains-table" hx-swap-oob="true">
  <thead>
    <tr>
      <th class="domain">Domain</th>
      <th class="homepage">Homepage</th>
      <th class="actions"></th>
    </tr>
  </thead>
  <tbody>
    {{#if domains}}
      {{#each domains}}
        <tr>
          <td class="domain right-fade">
            <span class="domain-address-line">
              {{address}}
              {{#ifEquals address ../user_default_domain}}
                <span class="domain-default-badge">Default</span>
              {{/ifEquals}}
            </span>
          </td>
          <td class="homepage right-fade">
            {{homepage}}
          </td>
          <td class="actions">
            <button 
              type="button"
              class="action delete" 
              data-action="open-dialog" data-dialog="domain-dialog" 
              hx-get="/confirm-domain-delete" 
              hx-target="#domain-dialog .content-wrapper" 
              hx-indicator="#domain-dialog" 
              hx-vals='{"id":"{{id}}"}'
            >
              {{> icons/trash}}
            </button>
          </td>
        </tr>
      {{/each}}
    {{else}}
      <tr>
        <td class="no-entry">
          No domains yet.
        </td>
      </tr>
    {{/if}}
  </tbody>
</table>
{{#if swap_oob_default}}
  {{> settings/domain/default_domain swap_oob=true}}
{{/if}}