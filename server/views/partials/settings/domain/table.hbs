<table id="domains-table" class="data-table data-table--domains" hx-swap-oob="true">
  <caption class="visually-hidden">Custom domains</caption>
  <thead>
    <tr>
      <th scope="col" class="domain">Domain</th>
      <th scope="col" class="homepage">Homepage</th>
      <th scope="col" class="actions"><span class="visually-hidden">Actions</span></th>
    </tr>
  </thead>
  <tbody>
    {{#if domains}}
      {{#each domains}}
        <tr>
          <td class="domain right-fade" data-label="Domain">
            <span class="domain-address-line">
              {{address}}
              {{#ifEquals address ../user_default_domain}}
                <span class="domain-default-badge">Default</span>
              {{/ifEquals}}
            </span>
          </td>
          <td class="homepage right-fade" data-label="Homepage">
            {{homepage}}
          </td>
          <td class="actions" data-label="Actions">
            <button
              type="button"
              class="action delete"
              aria-label="Delete {{address}}"
              data-tooltip="Delete"
              data-action="open-dialog" data-dialog="domain-dialog"
              hx-get="/confirm-domain-delete"
              hx-target="#domain-dialog .content-wrapper"
              hx-indicator="#domain-dialog"
              hx-vals='{"id":"{{id}}"}'
            >
              {{> icons/trash}}
            </button>
          </td>
        </tr>
      {{/each}}
    {{else}}
      <tr class="no-data">
        <td class="no-entry" colspan="3">
          No domains yet.
        </td>
      </tr>
    {{/if}}
  </tbody>
</table>
{{#if swap_oob_default}}
  {{> settings/domain/default_domain swap_oob=true}}
{{/if}}
