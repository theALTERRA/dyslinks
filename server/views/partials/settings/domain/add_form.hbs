<form
  id="add-domain"
  hx-post="/api/domains"
  hx-sync="this:abort"
  hx-swap="outerHTML"
>
  <div class="inputs">
    <div class="field {{#if errors.address}}error{{/if}}">
      <label for="address">Address:</label>
      <input
        id="address"
        name="address"
        type="text"
        placeholder="yoursite.com"
        required
        hx-preserve="true"
        {{#if errors.address}}aria-invalid="true" aria-describedby="add-domain-err-address"{{/if}}
      />
      {{#if errors.address}}<p id="add-domain-err-address" class="error" role="alert">{{errors.address}}</p>{{/if}}
    </div>
    <div class="field {{#if errors.homepage}}error{{/if}}">
      <label for="homepage">Homepage (Optional):</label>
      <input
        id="homepage"
        name="homepage"
        placeholder="Homepage URL"
        type="url"
        inputmode="url"
        hx-preserve="true"
        {{#if errors.homepage}}aria-invalid="true" aria-describedby="add-domain-err-homepage"{{/if}}
      />
      {{#if errors.homepage}}<p id="add-domain-err-homepage" class="error" role="alert">{{errors.homepage}}</p>{{/if}}
    </div>
  </div>
  <p>
    <small>
      If you leave homepage empty, <b>yoursite.com</b> will be redirected to <b>{{default_domain}}</b>.
    </small>
  </p>
  <div class="buttons-wrapper">
    <button type="button" data-action="cancel-add-domain">
      Cancel
    </button>
    <button type="submit" class="primary">
      <span>{{> icons/plus}}</span>
      Add domain
    </button>
  </div>
  {{> icons/spinner}}
  {{#unless errors}}
    {{#if error}}
      <p class="error" role="alert">{{error}}</p>
    {{/if}}
  {{/unless}}
</form>
