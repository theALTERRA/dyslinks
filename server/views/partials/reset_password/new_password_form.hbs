<form
  id="new-password-form"
  class="htmx-spinner"
  hx-post="/api/auth/new-password"
  hx-vals='{"reset_password_token":"{{reset_password_token}}"}'
  hx-sync="this:abort"
  hx-swap="outerHTML"
>
  <div class="field {{#if errors.new_password}}error{{/if}}">
    <label for="new_password">New password:</label>
    <div class="password-input-wrapper">
      <input
        id="new_password"
        name="new_password"
        type="password"
        placeholder="New password..."
        hx-preserve="true"
        required
        autocomplete="new-password"
        {{#if errors.new_password}}aria-invalid="true" aria-describedby="new-password-error"{{/if}}
      />
      <button
        type="button"
        class="password-toggle"
        data-action="toggle-password"
        aria-label="Show password"
        aria-pressed="false"
      >
        <span class="icon-show">{{> icons/eye}}</span>
        <span class="icon-hide">{{> icons/eye_off}}</span>
      </button>
    </div>
    {{#if errors.new_password}}<p id="new-password-error" class="error" role="alert">{{errors.new_password}}</p>{{/if}}
  </div>
  <div class="field {{#if errors.repeat_password}}error{{/if}}">
    <label for="repeat_password">Repeat password:</label>
    <div class="password-input-wrapper">
      <input
        id="repeat_password"
        name="repeat_password"
        type="password"
        placeholder="Repeat password..."
        hx-preserve="true"
        required
        autocomplete="new-password"
        {{#if errors.repeat_password}}aria-invalid="true" aria-describedby="repeat-password-error"{{/if}}
      />
      <button
        type="button"
        class="password-toggle"
        data-action="toggle-password"
        aria-label="Show password"
        aria-pressed="false"
      >
        <span class="icon-show">{{> icons/eye}}</span>
        <span class="icon-hide">{{> icons/eye_off}}</span>
      </button>
    </div>
    {{#if errors.repeat_password}}<p id="repeat-password-error" class="error" role="alert">{{errors.repeat_password}}</p>{{/if}}
  </div>
  <button type="submit" class="primary">
    <span>{{> icons/spinner}}</span>
    Set password
  </button>
  {{#unless errors}}
    {{#if error}}
      <p class="error" role="alert">{{error}}</p>
    {{/if}}
  {{/unless}}
</form>
