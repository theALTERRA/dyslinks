<td class="actions" data-label="Actions">
  <div class="actions-group">
    {{#if password}}
      <span class="action password" role="img" aria-label="Password protected" data-tooltip="Password protected" tabindex="0">
        {{> icons/key}}
      </span>
    {{/if}}
    {{#if banned}}
      <span class="action banned" role="img" aria-label="Banned" data-tooltip="Banned" tabindex="0">
        {{> icons/stop}}
      </span>
    {{/if}}
    <a
      class="button action stats"
      href="/stats?id={{id}}"
      aria-label="Stats for {{link.link}}"
      data-tooltip="Stats"
    >
      {{> icons/chart}}
    </a>
    <button
      type="button"
      class="action qrcode"
      aria-label="QR Code for {{link.link}}"
      data-tooltip="QR Code"
      data-action="open-qrcode" data-dialog="link-dialog"
      data-url="{{link.url}}"
    >
      {{> icons/qrcode}}
    </button>
    <button
      type="button"
      class="action edit"
      aria-label="Edit {{link.link}}"
      data-tooltip="Edit"
      aria-expanded="{{#if edit_expanded}}true{{else}}false{{/if}}"
      hx-trigger="click queue:none"
      hx-ext="path-params"
      hx-get="/link/edit/{id}"
      hx-vals='{"id":"{{id}}"}'
      hx-swap="beforeend"
      hx-target="next tr.edit"
      hx-indicator="next tr.edit"
      hx-sync="this:drop"
      data-action="toggle-edit-row"
    >
      {{> icons/pencil}}
    </button>
    <button
      type="button"
      class="action delete"
      aria-label="Delete {{link.link}}"
      data-tooltip="Delete"
      data-action="open-dialog" data-dialog="link-dialog"
      hx-get="/confirm-link-delete"
      hx-target="#link-dialog .content-wrapper"
      hx-indicator="#link-dialog"
      hx-vals='{"id":"{{id}}"}'
    >
      {{> icons/trash}}
    </button>
  </div>
</td>
