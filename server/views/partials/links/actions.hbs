<td class="actions">
  {{#if password}}
    <span class="action password" role="img" aria-label="Password protected" data-tooltip="Password protected">
      {{> icons/key}}
    </span>
  {{/if}}
  {{#if banned}}
    <span class="action banned" role="img" aria-label="Banned" data-tooltip="Banned">
      {{> icons/stop}}
    </span>
  {{/if}}
  <a
    class="button action stats"
    href="/stats?id={{id}}"
    aria-label="Stats"
    data-tooltip="Stats"
  >
    {{> icons/chart}}
  </a>
  <button
    type="button"
    class="action qrcode"
    aria-label="QR Code"
    data-tooltip="QR Code"
    data-action="open-qrcode" data-dialog="link-dialog"
    data-url="{{link.url}}"
  >
    {{> icons/qrcode}}
  </button>
  <button 
    type="button"
    class="action edit"
    aria-label="Edit"
    data-tooltip="Edit"
    hx-trigger="click queue:none"
    hx-ext="path-params"
    hx-get="/link/edit/{id}" 
    hx-vals='{"id":"{{id}}"}'
    hx-swap="beforeend"
    hx-target="next tr.edit"
    hx-indicator="next tr.edit"
    hx-sync="this:drop"
    data-action="toggle-edit-row"
  >
    {{> icons/pencil}}
  </button>
  <button 
    type="button"
    class="action delete" 
    aria-label="Delete"
    data-tooltip="Delete"
    data-action="open-dialog" data-dialog="link-dialog" 
    hx-get="/confirm-link-delete" 
    hx-target="#link-dialog .content-wrapper" 
    hx-indicator="#link-dialog" 
    hx-vals='{"id":"{{id}}"}'
  >
    {{> icons/trash}}
  </button>
</td>