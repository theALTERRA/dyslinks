<th class="nav" >
  <div class="limit">
    <button type="button" class="nav" data-action="set-limit" disabled="true">10</button>
    <button type="button" class="nav" data-action="set-limit">20</button>
    <button type="button" class="nav" data-action="set-limit">50</button>
  </div>
  <div class="nav-divider"></div>
  <div class="pagination">
    <button type="button" class="nav prev" data-action="set-skip" data-direction="prev" disabled="true">
      {{> icons/chevron_left}}
    </button>
    <button type="button" class="nav next" data-action="set-skip" data-direction="next" disabled="true">
      {{> icons/chevron_right}}
    </button>
  </div>
</th>