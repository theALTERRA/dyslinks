<thead>
  <tr>
    <th scope="col" class="select-col">
      <input
        type="checkbox"
        id="select-all-links-checkbox"
        aria-label="Select all links"
        data-action="toggle-select-all-links-checkbox"
        disabled
      />
    </th>
    <th scope="col" class="original-url">Original URL</th>
    <th scope="col" class="created-at">Created at</th>
    <th scope="col" class="short-link">Short link</th>
    <th scope="col" class="views">Views</th>
    <th scope="col" class="actions"><span class="visually-hidden">Actions</span></th>
  </tr>
</thead>
