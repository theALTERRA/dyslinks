<div class="content">
  <div class="icon success" aria-hidden="true">
    {{> icons/check}}
  </div>
  <h1 id="dialog-title" class="visually-hidden">Links deleted</h1>
  <p role="status">
    <b>{{count_formatted}}</b> {{#if is_plural}}links have{{else}}link has{{/if}} been deleted.
  </p>
  <div class="buttons">
    <button type="button" data-action="close-dialog" autofocus>Close</button>
  </div>
</div>
