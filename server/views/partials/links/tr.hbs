<tr id="tr-{{id}}" {{#if swap_oob}}hx-swap-oob="true"{{/if}}>
  <td class="select-col" data-label="Select">
    <input
      type="checkbox"
      class="link-select-checkbox"
      value="{{id}}"
      aria-label="Select {{link.link}}"
      data-action="toggle-select-link"
    />
  </td>
  <td class="original-url right-fade" data-label="Original URL">
    <div class="url-cell">
      <span class="url-icon-badge" aria-hidden="true">{{> icons/globe}}</span>
      <div class="cell-stack">
        {{#if is_http_target}}
          <a href="{{target}}" target="_blank" rel="noopener noreferrer" title="{{target}}">
            {{target}}
          </a>
        {{else}}
          <span class="non-http-target" title="{{target}}">{{target}}</span>
        {{/if}}
        {{#if description}}
          <p class="description">
            {{description}}
          </p>
        {{/if}}
      </div>
    </div>
  </td>
  <td class="short-link right-fade" data-label="Short link">
    <div class="short-link-wrapper">
      <div class="clipboard small">
        <button
          type="button"
          aria-label="Copy {{link.link}}"
          data-tooltip="Copy link"
          data-action="copy-link"
          data-url="{{link.url}}"
        >
          {{> icons/copy}}
        </button>
        {{> icons/check}}
      </div>
      <a href="{{link.url}}" target="_blank" rel="noopener noreferrer">
        {{link.link}}
      </a>
    </div>
  </td>
  <td class="views" data-label="Views">
    <span class="views-badge">
      {{> icons/activity}}
      <span>{{visit_count}}</span>
    </span>
  </td>
  <td class="created-at" data-label="Created at">
    <div class="cell-stack">
      <span>{{relative_created_at}}</span>
      {{#if is_expired}}
        <p class="description">
          Expired
        </p>
      {{else if relative_expire_in}}
        <p class="description">
          Expires in {{relative_expire_in}}
        </p>
      {{/if}}
    </div>
  </td>
  {{> links/actions}}
</tr>
<tr class="edit">
  <td class="loading" colspan="6">
    {{> icons/spinner}}
  </td>
</tr>
