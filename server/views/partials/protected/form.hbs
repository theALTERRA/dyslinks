<form
  id="protected-form"
  method="post"
  action="/api/links/{{id}}/protected"
  hx-post="/api/links/{{id}}/protected"
  hx-sync="this:abort"
  hx-swap="outerHTML"
> 
  {{#if message}}
    <p class="success">{{message}}</p>
  {{else}}
    <div class="inputs-wrapper">
      <label class="{{#if error}}error{{/if}}">
        Password
        <input 
          type="password" 
          id="protected-link-password" 
          name="password" 
          placeholder="Enter password..."
          autofocus="true"
          autocomplete="current-password"
          hx-preserve="true"
          required 
        />
      </label>
      <button type="submit" class="primary">
        <span>{{> icons/spinner}}</span>
        <span>{{> icons/key}}</span>
        Unlock & Go
      </button>
    </div>
    {{#if error}}<p class="error">{{error}}</p>{{/if}}
  {{/if}}
</form>