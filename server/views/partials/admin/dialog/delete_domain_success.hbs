<div class="content">
  <div class="icon success" aria-hidden="true">
    {{> icons/check}}
  </div>
  <h1 id="dialog-title" class="visually-hidden">Domain deleted</h1>
  <p role="status">
    The domain <b>"{{address}}"</b> has been deleted.
  </p>
  <div class="buttons">
    <button type="button" data-action="close-dialog" autofocus>Close</button>
  </div>
</div>
