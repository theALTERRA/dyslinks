<div class="content">
  <h1 id="dialog-title" class="visually-hidden">Notice</h1>
  {{#if error}}
    <p role="alert">{{error}}</p>
  {{else}}
    <p role="status">{{message}}</p>
  {{/if}}
  <div class="buttons">
    <button type="button" data-action="close-dialog" autofocus>Close</button>
  </div>
</div>
