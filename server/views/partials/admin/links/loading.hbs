{{#unless links}}
  {{#ifEquals links.length 0}}
    <tr class="no-data">
      <td colspan="5">
        No links.
      </td>
    </tr>
  {{else}}
    <tr class="loading-placeholder">
      <td colspan="5">
        <span class="loading-inline" role="status">
          {{> icons/spinner}}
          Loading links...
        </span>
      </td>
    </tr>
  {{/ifEquals}}
{{/unless}}
