<td class="content" colspan="5">
  {{#if id}}
    <form
      id="edit-form-{{id}}"
      hx-patch="/api/links/admin/{id}"
      hx-ext="path-params"
      hx-vals='{"id":"{{id}}"}'
      hx-select="form"
      hx-swap="outerHTML"
      hx-sync="this:replace"
      class="{{class}}"
    >
      <div>
        <div class="field {{#if errors.target}}error{{/if}}">
          <label for="edit-target-{{id}}">Target:</label>
          <input
            id="edit-target-{{id}}"
            name="target"
            type="url"
            inputmode="url"
            placeholder="Target..."
            required
            value="{{target}}"
            hx-preserve="true"
            {{#if errors.target}}aria-invalid="true" aria-describedby="edit-target-error-{{id}}"{{/if}}
          />
          {{#if errors.target}}<p id="edit-target-error-{{id}}" class="error" role="alert">{{errors.target}}</p>{{/if}}
        </div>
        <div class="field {{#if errors.address}}error{{/if}}">
          <label for="edit-address-{{id}}">
            <span id="edit-link-domain-{{id}}" hx-preserve="true">{{domain}}/</span>
          </label>
          <input
            id="edit-address-{{id}}"
            name="address"
            type="text"
            placeholder="Custom URL..."
            required
            value="{{address}}"
            hx-preserve="true"
            {{#if errors.address}}aria-invalid="true" aria-describedby="edit-address-error-{{id}}"{{/if}}
          />
          {{#if errors.address}}<p id="edit-address-error-{{id}}" class="error" role="alert">{{errors.address}}</p>{{/if}}
        </div>
        <div class="field {{#if errors.password}}error{{/if}}">
          <label for="edit-password-{{id}}">Password:</label>
          <input
            id="edit-password-{{id}}"
            name="password"
            type="password"
            autocomplete="new-password"
            placeholder="Password..."
            value="{{#if password}}••••••••{{/if}}"
            hx-preserve="true"
            {{#if errors.password}}aria-invalid="true" aria-describedby="edit-password-error-{{id}}"{{/if}}
          />
          {{#if errors.password}}<p id="edit-password-error-{{id}}" class="error" role="alert">{{errors.password}}</p>{{/if}}
        </div>
      </div>
      <div>
        <div class="field {{#if errors.description}}error{{/if}}">
          <label for="edit-description-{{id}}">Description:</label>
          <input
            id="edit-description-{{id}}"
            name="description"
            type="text"
            placeholder="Description..."
            value="{{description}}"
            hx-preserve="true"
            {{#if errors.description}}aria-invalid="true" aria-describedby="edit-description-error-{{id}}"{{/if}}
          />
          {{#if errors.description}}<p id="edit-description-error-{{id}}" class="error" role="alert">{{errors.description}}</p>{{/if}}
        </div>
        <div class="field {{#if errors.expire_in}}error{{/if}}">
          <label for="edit-expire_in-{{id}}">Expire in:</label>
          <input
            type="hidden"
            name="initial_expire_in"
            value="{{#if initial_expire_in}}{{initial_expire_in}}{{else}}{{edit_expire_in}}{{/if}}"
          />
          <input
            id="edit-expire_in-{{id}}"
            name="expire_in"
            type="text"
            placeholder="2 minutes/hours/days"
            value="{{edit_expire_in}}"
            hx-preserve="true"
            {{#if errors.expire_in}}aria-invalid="true" aria-describedby="edit-expire-in-error-{{id}}"{{/if}}
          />
          {{#if errors.expire_in}}<p id="edit-expire-in-error-{{id}}" class="error" role="alert">{{errors.expire_in}}</p>{{/if}}
        </div>
      </div>
      <div class="edit-actions">
        <button
          type="button"
          data-action="close-edit-row"
        >
          Close
        </button>
        <button type="submit" class="primary">
          <span class="reload">
            {{> icons/reload}}
          </span>
          <span class="loader">
            {{> icons/spinner}}
          </span>
          Update
        </button>
      </div>
      <div class="response">
        {{#if error}}
          {{#unless errors}}
            <p class="error" role="alert">{{error}}</p>
          {{/unless}}
        {{else if success}}
          <p class="success" role="status">{{success}}</p>
        {{/if}}
      </div>
      <template>
        {{> admin/links/tr}}
      </template>
    </form>
  {{else}}
    <p class="no-data">No link was found.</p>
  {{/if}}
</td>
