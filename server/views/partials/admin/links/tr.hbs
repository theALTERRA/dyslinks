<tr id="tr-{{id}}" {{#if swap_oob}}hx-swap-oob="true"{{/if}}>
  <td class="original-url right-fade" data-label="Original URL">
    <div class="cell-stack">
      {{#if is_http_target}}
        <a href="{{target}}" target="_blank" rel="noopener noreferrer">
          {{target}}
        </a>
      {{else}}
        <span class="non-http-target">{{target}}</span>
      {{/if}}
      <p class="description">
        by&nbsp;
        {{~#if user_id~}}
          <button
            type="button"
            class="link"
            aria-label="View user {{email}}"
            data-tooltip="View user"
            hx-get="/api/users/admin"
            hx-target="closest .table-card"
            hx-swap="outerHTML"
            hx-sync="this:replace"
            hx-indicator="closest .table-card"
            hx-vals='{"search":"{{email}}"}'
            data-action="set-tab" data-tab-target="tab-users"
          >
            {{email}}
          </button>
          {{#ifEquals @root.query.user email}}
          {{else}}
            &nbsp;(
            <button
              type="button"
              class="link"
              aria-label="View links by {{email}}"
              data-tooltip="View links by this user"
              hx-get="/api/links/admin"
              hx-target="closest .table-card"
              hx-swap="outerHTML"
              hx-sync="this:replace"
              hx-indicator="closest .table-card"
              hx-vals='{"user":"{{email}}"}'
            >
              view links
            </button>)
          {{/ifEquals}}
        {{~else~}}
          <button
            type="button"
            class="link"
            aria-label="View anonymous links"
            data-tooltip="View anonymous links"
            hx-get="/api/links/admin"
            hx-target="closest .table-card"
            hx-swap="outerHTML"
            hx-sync="this:replace"
            hx-indicator="closest .table-card"
            hx-vals='{"anonymous":"true"}'
          >
            Anonymous
          </button>
        {{~/if~}}
        &nbsp;{{~#if description~}}· {{description}}{{~/if}}
      </p>
    </div>
  </td>
  <td class="created-at" data-label="Created at">
    <div class="cell-stack">
      <span>{{relative_created_at}}</span>
      {{#if is_expired}}
        <p class="description">
          Expired
        </p>
      {{else if relative_expire_in}}
        <p class="description">
          Expires in {{relative_expire_in}}
        </p>
      {{/if}}
    </div>
  </td>
  <td class="short-link right-fade" data-label="Short link">
    <div class="cell-stack">
      <div class="short-link-wrapper">
        <div class="clipboard small">
          <button
            type="button"
            aria-label="Copy {{link.url}}"
            data-action="copy-link"
            data-url="{{link.url}}"
          >
            {{> icons/copy}}
          </button>
          {{> icons/check}}
        </div>
        <a href="{{link.url}}" target="_blank" rel="noopener noreferrer">/{{link.address}}</a>
      </div>
      <p class="description">
        <button
          type="button"
          class="link"
          aria-label="View links by domain {{domain}}"
          data-tooltip="View links by this domain"
          hx-get="/api/links/admin"
          hx-target="closest .table-card"
          hx-swap="outerHTML"
          hx-sync="this:replace"
          hx-vals='{"domain":"{{domain}}"}'
          hx-indicator="closest .table-card"
        >{{domain}}</button>
      </p>
    </div>
  </td>
  <td class="views" data-label="Views">
    {{visit_count}}
  </td>
  {{> admin/links/actions}}
</tr>
<tr class="edit">
  <td class="loading" colspan="5">
    {{> icons/spinner}}
  </td>
</tr>
