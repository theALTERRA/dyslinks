{{#unless table_domains}}
  {{#ifEquals table_domains.length 0}}
    <tr class="no-data">
      <td colspan="6">
        No domains.
      </td>
    </tr>
  {{else}}
    <tr class="loading-placeholder">
      <td colspan="6">
        <span class="loading-inline" role="status">
          {{> icons/spinner}}
          Loading domains...
        </span>
      </td>
    </tr>
  {{/ifEquals}}
{{/unless}}
