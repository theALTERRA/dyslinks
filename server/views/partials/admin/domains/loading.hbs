{{#unless table_domains}}
  {{#ifEquals table_domains.length 0}}
    <tr class="no-data">
      <td colspan="6">
        <div class="empty-state">
          <div class="empty-state-icon" aria-hidden="true">
            {{> icons/globe}}
          </div>
          <p class="empty-state-title">No domains found</p>
          <p class="empty-state-subtitle">No custom domains match the current filters.</p>
        </div>
      </td>
    </tr>
  {{else}}
    <tr class="loading-placeholder">
      <td colspan="6">
        <span class="loading-inline" role="status">
          {{> icons/spinner}}
          Loading domains...
        </span>
      </td>
    </tr>
  {{/ifEquals}}
{{/unless}}
