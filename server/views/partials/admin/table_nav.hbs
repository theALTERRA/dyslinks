<div class="nav">
  <div class="limit" role="group" aria-label="Rows per page">
    <button type="button" class="nav active" data-action="set-limit" aria-pressed="true">10</button>
    <button type="button" class="nav" data-action="set-limit" aria-pressed="false">20</button>
    <button type="button" class="nav" data-action="set-limit" aria-pressed="false">50</button>
  </div>
  <div class="nav-divider" aria-hidden="true"></div>
  <div class="pagination" role="group" aria-label="Pagination">
    <button type="button" class="nav prev" aria-label="Previous page" data-action="set-skip" data-direction="prev" disabled>
      {{> icons/chevron_left}}
    </button>
    <button type="button" class="nav next" aria-label="Next page" data-action="set-skip" data-direction="next" disabled>
      {{> icons/chevron_right}}
    </button>
  </div>
</div>
