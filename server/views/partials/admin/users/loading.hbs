{{#unless users}}
  {{#ifEquals users.length 0}}
    <tr class="no-data">
      <td colspan="7">
        <div class="empty-state">
          <div class="empty-state-icon" aria-hidden="true">
            {{> icons/new_user}}
          </div>
          <p class="empty-state-title">No users found</p>
          <p class="empty-state-subtitle">No user accounts match the current filters.</p>
        </div>
      </td>
    </tr>
  {{else}}
    <tr class="loading-placeholder">
      <td colspan="7">
        <span class="loading-inline" role="status">
          {{> icons/spinner}}
          Loading users...
        </span>
      </td>
    </tr>
  {{/ifEquals}}
{{/unless}}
