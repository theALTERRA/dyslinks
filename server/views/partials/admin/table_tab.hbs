<div class="table-category">
  <div class="category-total">
    <p id="category-total">
      Total {{title}}: <b>{{#if total includeZero=true}}{{total_formatted}}{{else}}-{{/if}}</b>
    </p>
  </div>
  <div class="category-tab">
    <nav class="tab" role="tablist" aria-label="Admin resource tables">
      <button
        type="button"
        id="tab-links"
        role="tab"
        aria-selected="{{#ifEquals title 'links'}}true{{else}}false{{/ifEquals}}"
        hx-get="/api/links/admin"
        hx-target="closest .table-card"
        hx-swap="outerHTML"
        hx-disinherit="*"
        hx-sync="this:replace"
        hx-indicator="closest .table-card"
        data-action="set-tab"
        {{#ifEquals title 'links'}}
          class="active"
          data-prevent-active-request="true"
        {{/ifEquals}}
      >
        Links
      </button>
      <button
        type="button"
        id="tab-users"
        role="tab"
        aria-selected="{{#ifEquals title 'users'}}true{{else}}false{{/ifEquals}}"
        hx-get="/api/users/admin"
        hx-target="closest .table-card"
        hx-swap="outerHTML"
        hx-disinherit="*"
        hx-sync="this:replace"
        hx-indicator="closest .table-card"
        data-action="set-tab"
        {{#ifEquals title 'users'}}
          class="active"
          data-prevent-active-request="true"
        {{/ifEquals}}
      >
        Users
      </button>
      <button
        type="button"
        id="tab-domains"
        role="tab"
        aria-selected="{{#ifEquals title 'domains'}}true{{else}}false{{/ifEquals}}"
        hx-get="/api/domains/admin"
        hx-target="closest .table-card"
        hx-swap="outerHTML"
        hx-disinherit="*"
        hx-sync="this:replace"
        hx-indicator="closest .table-card"
        data-action="set-tab"
        {{#ifEquals title 'domains'}}
          class="active"
          data-prevent-active-request="true"
        {{/ifEquals}}
      >
        Domains
      </button>
    </nav>
  </div>
</div>
