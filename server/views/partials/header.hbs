<header>
  <div class="header-inner">
    <div class="logo-wrapper">
      <a class="logo nav" href="{{site_url}}/">
        <svg class="logo-mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="24" height="24" shape-rendering="crispEdges" aria-hidden="true">
          <rect class="logo-d" x="3" y="3" width="2" height="10"/>
          <rect class="logo-d" x="5" y="3" width="4" height="2"/>
          <rect class="logo-d" x="5" y="11" width="4" height="2"/>
          <rect class="logo-d" x="9" y="5" width="2" height="6"/>
          <rect class="logo-dot" x="11" y="11" width="2" height="2"/>
        </svg>
        {{site_name}}
      </a>
      <ul class="logo-links">
        <li>
          <a class="nav" href="https://github.com/theALTERRA/dyslinks" target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
        </li>
        {{#if report_email}}
          <li>
            <a class="nav" href="{{site_url}}/report">
              Report
            </a>
          </li>
        {{/if}}
      </ul>
    </div>
    <nav aria-label="Primary">
      <ul>
        {{#if user}}
          <li>
            <form method="post" action="{{site_url}}/api/auth/logout" class="logout-form">
              <button type="submit" class="nav">
                Log out
              </button>
            </form>
          </li>
          {{#if isAdmin}}
            <li>
              <a class="button secondary" href="{{site_url}}/admin">
                <span>{{> icons/shield}}</span>
                Admin
              </a>
            </li>
          {{/if}}
          <li>
            <a class="button primary" href="{{site_url}}/settings">
              <span>{{> icons/cog}}</span>
              Settings
            </a>
          </li>
        {{/if}}
        {{#unless user}}
          {{#unless login_disabled}}
            <li>
              <a class="button primary" href="{{site_url}}/login">
                {{#if disallow_registration}}Log in{{else}}Log in / Sign up{{/if}}
              </a>
            </li>
          {{/unless}}
        {{/unless}}
        <li class="theme-toggle-item">
          <button
            type="button"
            id="theme-toggle"
            class="theme-toggle"
            data-tooltip="Switch theme"
          >
            {{> icons/sun}}
            {{> icons/moon}}
            <span class="visually-hidden theme-label-light">Switch to light mode</span>
            <span class="visually-hidden theme-label-dark">Switch to dark mode</span>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>
