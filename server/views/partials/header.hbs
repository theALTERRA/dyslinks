<header>
  <div class="header-inner">
    <div class="logo-wrapper">
      <a class="logo nav" href="{{site_url}}/" title="Homepage">
        <svg class="logo-mark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="24" height="24" shape-rendering="crispEdges" aria-hidden="true">
          <rect class="logo-d" x="3" y="3" width="2" height="10"/>
          <rect class="logo-d" x="5" y="3" width="4" height="2"/>
          <rect class="logo-d" x="5" y="11" width="4" height="2"/>
          <rect class="logo-d" x="9" y="5" width="2" height="6"/>
          <rect class="logo-dot" x="11" y="11" width="2" height="2"/>
        </svg>
        {{site_name}}
      </a>
      <ul class="logo-links">
        <li>
          <a class="nav" href="https://github.com/theALTERRA/dyslinks" target="_blank" rel="noopener noreferrer" title="GitHub">
            GitHub
          </a>
        </li>
        {{#if report_email}}
          <li>
            <a class="nav" href="{{site_url}}/report" title="Report abuse">
              Report
            </a>
          </li>
        {{/if}}
      </ul>
    </div>
    <nav>
      <ul>
        <li class="theme-toggle-item">
          <button
            type="button"
            id="theme-toggle"
            class="theme-toggle"
            aria-label="Toggle dark mode"
            title="Toggle dark mode"
          >
            {{> icons/sun}}
            {{> icons/moon}}
          </button>
        </li>
        {{#unless user}}
          {{#unless login_disabled}}
            <li>
              <a class="button primary" href="{{site_url}}/login" title="{{#if disallow_registration}}Log in{{else}}Log in or sign up{{/if}}">
                {{#if disallow_registration}}Log in{{else}}Log in / Sign up{{/if}}
              </a>
            </li>
          {{/unless}}
        {{/unless}}
        {{#if user}}
          <li>
            <a class="button primary" href="{{site_url}}/settings" title="Settings">
              <span>{{> icons/cog}}</span>
              Settings
            </a>
          </li>
          {{#if isAdmin}}
            <li>
              <a class="button secondary" href="{{site_url}}/admin" title="Admin">
                <span>{{> icons/shield}}</span>
                Admin
              </a>
            </li>
          {{/if}}
          <li>
            <a class="nav" href="{{site_url}}/logout" title="Log out">
              Log out
            </a>
          </li>
        {{/if}}
      </ul>
    </nav>
  </div>
</header>