{{> header}}
<main id="main-content" class="page-main" tabindex="-1">
  <section id="settings" class="section-container">
    <h1 class="settings-welcome">
      Welcome, <span>{{user.email}}</span>
    </h1>
    <hr />
    {{#if can_use_custom_domains}}
      {{> settings/domain/index}}
      <hr />
    {{/if}}
    {{#if can_use_custom_domains}}
      {{> settings/domain/default_domain}}
      <hr />
    {{else if shortener_domains.length}}
      {{> settings/domain/default_domain}}
      <hr />
    {{/if}}
    {{> settings/apikey}}
    <hr />
    {{> settings/change_password}}
    <hr />
    {{#if mail_enabled}}
      {{> settings/change_email}}
      <hr />
    {{/if}}
    {{> settings/delete_account}}
  </section>
</main>
{{> footer}}
