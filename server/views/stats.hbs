{{> header}}
<section
  id="stats-section"
  class="section-container"
  hx-get="/api/links/{id}/stats"
  hx-swap="innerHTML"
  hx-trigger="load once"
>
  <div class="loading-stats">
    {{> icons/spinner}}
    Loading stats...
  </div>
</section>
{{> footer}}
{{#extend "scripts"}}
  <script src="/libs/chart.min.js"></script>
  <script src="/scripts/stats.js?v={{app_version}}"></script>
{{/extend}}
