{{> header}}
<main id="main-content" class="page-main" tabindex="-1">
  <section
    id="stats-section"
    class="section-container"
    hx-get="/api/links/{id}/stats"
    hx-swap="innerHTML"
    hx-trigger="load once"
  >
    <div class="loading-stats" role="status">
      {{> icons/spinner}}
      Loading stats...
    </div>
  </section>
</main>
{{> footer}}
{{#extend "scripts"}}
  <script defer src="/libs/chart.min.js"></script>
  <script defer src="/scripts/stats.js?v={{app_version}}"></script>
{{/extend}}
